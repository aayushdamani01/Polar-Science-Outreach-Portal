PORT=5000
NODE_ENV=development

# PostgreSQL (used by Prisma)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ncpor_portal?schema=public"

# Auth
JWT_SECRET=change_this_to_a_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (get these from cloudinary.com dashboard after signup)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI content generation (Google Gemini API — free tier)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Frontend origin (used for CORS in production)
FRONTEND_URL=http://localhost:5173
